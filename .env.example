# Copie para .env (local) ou cadastre cada variavel em Coolify > Environment Variables.

# Banco (Postgres). Se o app e o banco estao na mesma VPS/Coolify, prefira a URL interna do recurso
# (ex.: postgresql://USUARIO:SENHA@<nome-do-container>:5432/db_pitfinance) em vez do IP publico.
DATABASE_URL=postgresql://USUARIO:SENHA@207.180.222.79:5432/db_pitfinance

PORT=8347
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=7d

# Dominio publico do front (CORS). Sem barra no final.
FRONTEND_URL=https://app.seudominio.com.br

GROQ_API_KEY=

MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM_NAME=PIT Finance

# Despesas fixas automaticas (so "true" liga)
FIXED_EXPENSES_AUTOGEN=true
FIXED_EXPENSES_AUTOGEN_USERS=
FIXED_EXPENSES_AUTOGEN_MAX_ROWS=500
APP_TIMEZONE=America/Sao_Paulo

# Assinaturas (AbacatePay)
BILLING_ENFORCE=true
ABACATEPAY_API_KEY=
ABACATEPAY_WEBHOOK_SECRET=
ABACATEPAY_WEBHOOK_PUBLIC_KEY=
ABACATEPAY_PRODUCT_MONTHLY=
ABACATEPAY_PRODUCT_ANNUAL=
