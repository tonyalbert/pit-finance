generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TagType {
  INCOME
  EXPENSE
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  isAdmin      Boolean   @default(false)
  // Acesso: fim do teste gratis (null = sem teste) e acesso vitalicio concedido pelo admin.
  // trialStartedAt: quando o usuario escolheu o teste (uma vez por conta; null = ainda pode escolher).
  trialStartedAt DateTime?
  trialEndsAt    DateTime?
  lifetimeAccess Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  subscription        Subscription?
  tags                Tag[]
  incomes             Income[]
  expenses            Expense[]
  creditors           Creditor[]
  passwordResetTokens PasswordResetToken[]
  fixedExpenses       FixedExpense[]
  fixedIncomes        FixedIncome[]
  savingsGoals        SavingsGoal[]
  savingsMovements    SavingsMovement[]
  savingsLoans        SavingsLoan[]
  tickets             Ticket[]
  ticketMessages      TicketMessage[]
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Tag {
  id        String   @id @default(uuid())
  name      String
  type      TagType
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  incomes       Income[]
  expenses      Expense[]
  fixedExpenses FixedExpense[]
  fixedIncomes  FixedIncome[]

  @@unique([userId, name, type])
  @@index([userId, type])
}

model Creditor {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  email     String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses      Expense[]
  fixedExpenses FixedExpense[]

  @@unique([userId, name])
  @@index([userId])
}

model Income {
  id        String   @id @default(uuid())
  source    String
  amount    Decimal  @db.Decimal(12, 2)
  date      DateTime
  tagId     String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag  Tag? @relation(fields: [tagId], references: [id], onDelete: SetNull)
  fixedIncome           FixedIncome? @relation(fields: [fixedIncomeId], references: [id], onDelete: SetNull)
  fixedIncomeId         String?
  fixedIncomeCompetence String?

  @@index([userId, date])
  @@index([fixedIncomeId])
  @@unique([fixedIncomeId, fixedIncomeCompetence])
}

model Expense {
  id                 String     @id @default(uuid())
  item               String
  amount             Decimal    @db.Decimal(12, 2)
  date               DateTime
  isPaid             Boolean    @default(false)
  installmentGroupId String?
  installmentNumber  Int?
  installmentTotal   Int?
  tagId              String?
  creditorId         String?
  userId             String
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag      Tag?     @relation(fields: [tagId], references: [id], onDelete: SetNull)
  creditor       Creditor?     @relation(fields: [creditorId], references: [id], onDelete: SetNull)
  fixedExpense   FixedExpense? @relation(fields: [fixedExpenseId], references: [id], onDelete: SetNull)
  fixedExpenseId String?
  fixedExpenseCompetence String?

  @@index([userId, date])
  @@index([userId, installmentGroupId])
  @@index([userId, creditorId])
  @@index([fixedExpenseId])
  @@unique([fixedExpenseId, fixedExpenseCompetence])
}

model FixedExpense {
  id         String   @id @default(uuid())
  name       String
  amount     Decimal  @db.Decimal(12, 2)
  dayOfMonth Int
  tagId      String?
  creditorId String?
  userId     String
  isActive   Boolean  @default(true)
  startDate  DateTime
  endDate    DateTime?
  skippedCompetences String[] @default([])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag      Tag?      @relation(fields: [tagId], references: [id], onDelete: SetNull)
  creditor Creditor? @relation(fields: [creditorId], references: [id], onDelete: SetNull)
  expenses Expense[]

  @@index([userId])
  @@index([userId, isActive])
}

// Receita fixa (salario, contrato...): gera uma Income por competencia, como FixedExpense.
// O valor muda ao longo do tempo: `amount` vale desde startDate e cada reajuste
// (FixedIncomeAdjustment) vale a partir da sua competencia ("YYYY-MM").
model FixedIncome {
  id         String   @id @default(uuid())
  name       String
  amount     Decimal  @db.Decimal(12, 2)
  dayOfMonth Int
  tagId      String?
  userId     String
  isActive   Boolean  @default(true)
  startDate  DateTime
  endDate    DateTime?
  skippedCompetences String[] @default([])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag         Tag?                    @relation(fields: [tagId], references: [id], onDelete: SetNull)
  incomes     Income[]
  adjustments FixedIncomeAdjustment[]

  @@index([userId])
  @@index([userId, isActive])
}

model FixedIncomeAdjustment {
  id            String   @id @default(uuid())
  fixedIncomeId String
  amount        Decimal  @db.Decimal(12, 2)
  effectiveFrom String
  createdAt     DateTime @default(now())

  fixedIncome FixedIncome @relation(fields: [fixedIncomeId], references: [id], onDelete: Cascade)

  @@unique([fixedIncomeId, effectiveFrom])
}

enum SavingsMovementType {
  DEPOSIT
  WITHDRAW
}

// Meta de economia: alvo + prazo. Quanto guardar por mes e calculado (nao armazenado).
// O dinheiro guardado NAO e despesa: e uma categoria propria ("Guardado") do mes.
model SavingsGoal {
  id              String   @id @default(uuid())
  name            String
  targetAmount    Decimal  @db.Decimal(12, 2)
  targetDate      DateTime
  // Ja guardado antes de criar a meta (nao conta como "Guardado" de nenhum mes).
  initialAmount   Decimal  @default(0) @db.Decimal(12, 2)
  isEmergencyFund Boolean  @default(false)
  // Primeiro mes de aporte ("YYYY-MM"); null = mes de criacao. Antes dele a meta nao pede aporte.
  startMonth      String?
  userId          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  movements SavingsMovement[]
  loans     SavingsLoan[]

  @@index([userId])
}

// Emprestimo da propria meta (ex.: reserva de emergencia). O principal sai da meta e as
// parcelas (tabela Price, juros definidos pelo usuario) viram despesas parceladas
// (Expense.installmentGroupId). Cada parcela PAGA volta para a meta, com juros.
model SavingsLoan {
  id                 String   @id @default(uuid())
  goalId             String
  userId             String
  principal          Decimal  @db.Decimal(12, 2)
  // Juros ao mes, em % (ex.: 1.5 = 1,5% a.m.).
  monthlyRate        Decimal  @db.Decimal(5, 2)
  installments       Int
  installmentAmount  Decimal  @db.Decimal(12, 2)
  firstDueDate       DateTime
  installmentGroupId String   @unique
  createdAt          DateTime @default(now())

  goal SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@index([userId])
}

// Aporte (DEPOSIT) ou retirada (WITHDRAW) confirmados pelo usuario; amount sempre positivo.
model SavingsMovement {
  id        String              @id @default(uuid())
  goalId    String
  userId    String
  type      SavingsMovementType
  amount    Decimal             @db.Decimal(12, 2)
  date      DateTime
  createdAt DateTime            @default(now())

  goal SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@index([userId, date])
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum TicketCategory {
  TECHNICAL
  FINANCIAL
  ACCOUNT
  OTHER
}

model Ticket {
  id          String         @id @default(uuid())
  title       String
  description String
  status      TicketStatus   @default(OPEN)
  category    TicketCategory @default(OTHER)
  userId      String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages TicketMessage[]

  @@index([userId])
  @@index([status])
}

model TicketMessage {
  id        String   @id @default(uuid())
  content   String
  ticketId  String
  userId    String
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([ticketId])
}

enum BillingPlan {
  MONTHLY
  ANNUALLY
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  CANCELLED
}

// Assinatura AbacatePay do usuario (1:1). O acesso pago vale ate currentPeriodEnd,
// atualizado SOMENTE pelos webhooks (nunca pelo retorno do front).
model Subscription {
  id               String             @id @default(uuid())
  userId           String             @unique
  customerId       String?            @unique
  subscriptionId   String?            @unique
  checkoutId       String?
  plan             BillingPlan?
  status           SubscriptionStatus @default(PENDING)
  currentPeriodEnd DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Idempotencia dos webhooks: o id do evento (log_...) e o mesmo em todas as retentativas.
model WebhookEvent {
  id         String   @id
  event      String
  receivedAt DateTime @default(now())
}
